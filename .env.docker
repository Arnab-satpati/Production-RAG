# LLM Configuration (Ollama - runs in Docker)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector Store (Qdrant - runs in Docker)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_LOCAL_MODE=false
QDRANT_COLLECTION=rag_documents

# Chunking
CHUNKING_CHUNK_SIZE=512
CHUNKING_CHUNK_OVERLAP=64

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.4

# Guardrails
GUARDRAILS_MAX_INPUT_LENGTH=10000
GUARDRAILS_RATE_LIMIT_PER_MINUTE=60
GUARDRAILS_ENABLE_OUTPUT_FILTERING=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
